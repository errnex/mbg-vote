X_CLIENT_ID=
X_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Supabase PostgreSQL connection string.
# Use the pooled connection string for Vercel and keep sslmode=require.
DATABASE_URL=postgresql://postgres.project-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Optional. Keep true/default for Supabase. Set false only for a local non-SSL Postgres.
DATABASE_SSL=true

# Optional server-only Supabase values if you later add Supabase Admin APIs.
# This project uses DATABASE_URL directly and does not expose these to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
